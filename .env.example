# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put blockchain private keys or the Supabase service-role key in this file.
# Configure these as Supabase Edge Function secrets:
# POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<key>
# POLYGON_PRIVATE_KEY=<dedicated-relayer-private-key>
# MRV_ANCHOR_CONTRACT_ADDRESS=<deployed-BlueCarbonMRVAnchor-address>
# MRV_BLOCKCHAIN_NETWORK_ID=<Amoy blockchain_networks.id>
# MRV_SMART_CONTRACT_ID=<deployed smart_contracts.id>
